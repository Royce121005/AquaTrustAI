{
  "name": "aquatrust-network-auditor",
  "version": "1.0.0",
  "client": {
    "organization": "AuditorOrg",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        },
        "orderer": "300"
      }
    }
  },
  "channels": {
    "aquatrust-channel": {
      "orderers": ["orderer.aquatrust.com"],
      "peers": {
        "peer0.auditor.aquatrust.com": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": true
        }
      }
    }
  },
  "organizations": {
    "AuditorOrg": {
      "mspid": "AuditorMSP",
      "peers": ["peer0.auditor.aquatrust.com"],
      "certificateAuthorities": ["ca.auditor.aquatrust.com"]
    }
  },
  "orderers": {
    "orderer.aquatrust.com": {
      "url": "grpcs://localhost:7050",
      "grpcOptions": {
        "ssl-target-name-override": "orderer.aquatrust.com"
      },
      "tlsCACerts": {
        "path": "crypto-config/ordererOrganizations/orderer.aquatrust.com/tlsca/tlsca.orderer.aquatrust.com-cert.pem"
      }
    }
  },
  "peers": {
    "peer0.auditor.aquatrust.com": {
      "url": "grpcs://localhost:8051",
      "grpcOptions": {
        "ssl-target-name-override": "peer0.auditor.aquatrust.com"
      },
      "tlsCACerts": {
        "path": "crypto-config/peerOrganizations/auditor.aquatrust.com/tlsca/tlsca.auditor.aquatrust.com-cert.pem"
      }
    }
  }
}
