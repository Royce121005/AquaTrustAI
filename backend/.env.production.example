# ==============================================================================
# AquaTrust AI — Production Environment Configuration (.env.production)
# ==============================================================================

# Application Identity & Lifecycle
APP_NAME="AquaTrust AI Backend"
APP_ENV=production
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_STR=/api/v1

# Structured Production Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Production CORS Security
# Specify only your exact deployed frontend domains (NEVER use * in production)
CORS_ORIGINS="https://aquatrust.yourdomain.com,https://aquatrust.vercel.app"

# Production PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@your-rds-or-cloud-db.internal:5432/aquatrust_db?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Cryptographic Security & JWT Signing
# Generate a fresh 256-bit cryptographically secure secret using:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Distributed Ledger Technology (DLT) Mode
# Options: SIMULATION (standalone testing) | FABRIC (Hyperledger Fabric network)
DLT_MODE=SIMULATION
