# AquaTrust AI Backend Environment Configuration Template (Phase 01 Foundation)
# Copy this file to .env and configure for your local/deployment environment.
# Never commit active secrets, private keys, or passwords.

# Application Information
APP_NAME="AquaTrust AI Backend"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
API_V1_STR=/api/v1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security & CORS
# Comma-separated list of allowed origins or JSON array
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Persistence Boundary (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# For local testing without PostgreSQL, SQLite in-memory or file fallback is permitted.
DATABASE_URL=postgresql://aquatrust_user:aquatrust_password@localhost:5432/aquatrust_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
